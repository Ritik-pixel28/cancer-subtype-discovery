.cache/
htmlcov/
.coverage

# Pipeline research execution scripts (not needed for web serving)
notebooks/
logs/
models/
scripts/

# Streamlit-only configuration
.streamlit/

# Test files (tested locally and in CI, not needed in production lambda)
tests/
